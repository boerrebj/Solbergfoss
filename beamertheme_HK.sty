\ProvidesClass{beamertheme_HK}[2023/02/17]

\mode<presentation>

\RequirePackage{pgf}
\RequirePackage[authoryear,round]{natbib}
\RequirePackage{xcolor}
\RequirePackage{textcomp}
\RequirePackage{carlito}


\definecolor{HK_dark_green}{RGB}{8,64,77} % HK_dark_green
\definecolor{HK_grey}{RGB}{51,51,51} % HK_grey
\definecolor{HK_light_green}{RGB}{223,242,238} % HK_light_green

\setbeamercolor{frametitle}{fg=HK_dark_green}
\setbeamercolor{title}{fg=HK_dark_green}
\setbeamercolor{subtitle}{fg=HK_grey}
\setbeamercolor{item}{fg=black}

%% turn off all navigation symbols
\setbeamertemplate{navigation symbols}{}

\mode<all>
